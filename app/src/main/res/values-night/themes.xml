<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kora_paper_night</item>
    </style>

    <style name="Theme.Kora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kora_paper_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/kora_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Kora</item>
    </style>
</resources>
